# /etc/systemd/system/mc-www.service
# Static files for Minecraft clients: server resource packs live in
# /srv/mc/_shared/www and are referenced from server.properties as
# resource-pack=http://192.168.0.250:8080/<file>.zip (+ resource-pack-sha1).
[Unit]
Description=Minecraft resource-pack web server (port 8080)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=minecraft
Group=minecraft
ExecStart=/usr/bin/python3 -m http.server 8080 --bind 0.0.0.0 --directory /srv/mc/_shared/www
Restart=on-failure
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
