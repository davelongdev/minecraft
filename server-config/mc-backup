#!/bin/bash
# /usr/local/bin/mc-backup <name>   run as root by mc-backup@<name>.timer (every 10 minutes)
# Backs up only while someone is playing, plus one last run after the last player leaves
# (state in /var/lib/mc-backup/<name>.online), so nothing from the final minutes is missed.
# Freezes the live world (save-off / save-all flush), snapshots the whole /srv/mc/<name> folder
# into the restic repo, then save-on. Every snapshot is kept (Dave, 2026-10-25): no forget/prune;
# restic stores only what changed, about 1-2 MB per run.
set -euo pipefail
n=$1
d=/srv/mc/$n
. "$d/.env"
export RESTIC_REPOSITORY=/home/backups/restic
export RESTIC_PASSWORD_FILE=/root/.restic-pw
export RESTIC_CACHE_DIR=/var/cache/restic   # systemd gives us no $HOME
state=/var/lib/mc-backup/$n.online
mkdir -p /var/lib/mc-backup

rcon() { mcrcon -H 127.0.0.1 -P "$RCON_PORT" -p "$RCON_PASSWORD" "$@"; }

systemctl is-active -q "minecraft@$n" || exit 0

if rcon list | grep -q 'There are 0 of'; then
  [ -e "$state" ] || exit 0      # nobody now, nobody last time: nothing changed
  rm -f "$state"                 # last run after everyone left
else
  touch "$state"
fi

trap 'rcon save-on >/dev/null' EXIT
rcon save-off "save-all flush" >/dev/null
sleep 2
sync

restic backup "$d" --tag "$n" --retry-lock 10m \
  --exclude '*.jar' --exclude logs --exclude cache \
  --exclude libraries --exclude .fabric --exclude versions \
  --exclude world.fresh --exclude 'world.before-*' --exclude '*.tgz'

