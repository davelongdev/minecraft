# Macro (id, name): sneak + right-click on a character opens this menu for the clicker.
$dialog show @s {type:"minecraft:multi_action",title:{text:"Edit $(name)",color:"gold",bold:true},external_title:"Edit $(name)",pause:false,after_action:"close",body:[],columns:1,actions:[{label:"Name, look, and greeting",action:{type:"minecraft:custom",id:"npc:internal/form_char_open",payload:{id:"$(id)"}}},{label:"Buttons",action:{type:"minecraft:custom",id:"npc:internal/form_buttons_open",payload:{id:"$(id)"}}},{label:"Bring here",action:{type:"minecraft:custom",id:"npc:internal/move_here",payload:{id:"$(id)"}}},{label:{text:"Delete",color:"red"},action:{type:"minecraft:custom",id:"npc:internal/confirm_delete",payload:{id:"$(id)",name:"$(name)"}}}],exit_action:{label:"Cancel"}}
