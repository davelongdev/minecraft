# Macro (cur, ph_name): Save runs name_apply as the player with the typed name pasted in ($(ph_name) = the literal placeholder)
$dialog show @s {type:"minecraft:confirmation",title:{text:"Choose your name",color:"gold",bold:true},external_title:"Choose your name",pause:false,body:[{type:"minecraft:plain_message",width:300,contents:{text:"This name goes on your island sign.",color:"white"}}],inputs:[{type:"minecraft:text",key:"name",label:"Your name",width:300,max_length:24,initial:"$(cur)"}],yes:{label:"Save",action:{type:"minecraft:dynamic/run_command",template:"function npc:internal/name_apply {name:\"$(ph_name)\"}"}},no:{label:"Cancel"}}
