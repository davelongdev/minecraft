# Macro (id, name, n, k, l, t, tlabel, yes, ph_l, ph_t): the fill-in screen for button n (label + dialogue or command).
$dialog show @s {type:"minecraft:confirmation",title:{text:"$(name) - Button $(n) of 3",color:"gold",bold:true},external_title:"Button $(n) of 3",pause:false,body:[],inputs:[{type:"minecraft:text",key:"label",label:"Button $(n) label",width:300,max_length:40,initial:"$(l)"},{type:"minecraft:text",key:"text",label:"$(tlabel)",width:300,max_length:200,initial:"$(t)"}],yes:{label:"$(yes)",action:{type:"minecraft:dynamic/custom",id:"npc:internal/form_button_apply",additions:{id:"$(id)",n:$(n),k:"$(k)"}}},no:{label:"Cancel"}}
