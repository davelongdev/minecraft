# Macro (name, greeting, l1..l3, n1..n3): the dialog screen with 3 button(s). Inline dialog, nothing on disk.
$dialog show @s {type:"minecraft:multi_action",title:{text:"$(name)",color:"gold",bold:true},external_title:"$(name)",pause:false,can_close_with_escape:true,after_action:"close",body:[{type:"minecraft:plain_message",width:300,contents:"$(greeting)"}],columns:1,actions:[{label:{text:"$(l1)",color:"green"},action:{type:"run_command",command:"trigger npc_choice set $(n1)"}},{label:{text:"$(l2)",color:"green"},action:{type:"run_command",command:"trigger npc_choice set $(n2)"}},{label:{text:"$(l3)",color:"green"},action:{type:"run_command",command:"trigger npc_choice set $(n3)"}}],exit_action:{label:"Bye"}}
