# Macro (id, name, n): ask screen for button 1 of 3, with the intro text.
$dialog show @s {type:"minecraft:multi_action",title:{text:"$(name) - Button $(n) of 3",color:"gold",bold:true},external_title:"Button $(n) of 3",pause:false,after_action:"close",body:[{type:"minecraft:plain_message",width:300,contents:{text:"When you right click on an NPC, you might see some buttons. You can click the buttons to interact with the NPC.\n",color:"white"}},{type:"minecraft:plain_message",width:300,contents:{text:"These screens will let you create buttons for your NPCs.\n",color:"white"}},{type:"minecraft:plain_message",width:300,contents:{text:"What should button $(n) do?",color:"white"}}],columns:1,actions:[{label:"Dialogue",action:{type:"minecraft:run_command",command:"function npc:internal/form_button_kind {id:\"$(id)\",n:$(n),k:\"say\"}"}},{label:"Run command",action:{type:"minecraft:run_command",command:"function npc:internal/form_button_kind {id:\"$(id)\",n:$(n),k:\"cmd\"}"}},{label:"No button $(n)",action:{type:"minecraft:run_command",command:"function npc:internal/form_button_skip {id:\"$(id)\",n:$(n)}"}}],exit_action:{label:"Cancel"}}
