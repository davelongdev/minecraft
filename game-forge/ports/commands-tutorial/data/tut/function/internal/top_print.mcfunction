scoreboard players add rank tut_const 1
execute if score rank tut_const matches 1 run tellraw @a[distance=0..] [{"font":"minecraft:uniform","text":"Gold ★ ","color":"gold","bold":true},{"font":"minecraft:uniform","selector":"@s","color":"gold","bold":true},{"font":"minecraft:uniform","text":" - ","color":"white"},{"font":"minecraft:uniform","score":{"name":"@s","objective":"tut_pts"},"color":"white"},{"font":"minecraft:uniform","text":" points","color":"white"}]
execute if score rank tut_const matches 2 run tellraw @a[distance=0..] [{"font":"minecraft:uniform","text":"Silver ★ ","color":"#c0c0c0","bold":true},{"font":"minecraft:uniform","selector":"@s","color":"#c0c0c0","bold":true},{"font":"minecraft:uniform","text":" - ","color":"white"},{"font":"minecraft:uniform","score":{"name":"@s","objective":"tut_pts"},"color":"white"},{"font":"minecraft:uniform","text":" points","color":"white"}]
execute if score rank tut_const matches 3 run tellraw @a[distance=0..] [{"font":"minecraft:uniform","text":"Bronze ★ ","color":"#cd7f32","bold":true},{"font":"minecraft:uniform","selector":"@s","color":"#cd7f32","bold":true},{"font":"minecraft:uniform","text":" - ","color":"white"},{"font":"minecraft:uniform","score":{"name":"@s","objective":"tut_pts"},"color":"white"},{"font":"minecraft:uniform","text":" points","color":"white"}]
execute if score rank tut_const matches 4.. run tellraw @a[distance=0..] [{"font":"minecraft:uniform","score":{"name":"rank","objective":"tut_const"},"color":"white"},{"font":"minecraft:uniform","text":"th   ","color":"white"},{"font":"minecraft:uniform","selector":"@s","color":"white"},{"font":"minecraft:uniform","text":" - ","color":"white"},{"font":"minecraft:uniform","score":{"name":"@s","objective":"tut_pts"},"color":"white"},{"font":"minecraft:uniform","text":" points","color":"white"}]
