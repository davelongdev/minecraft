{
  "type": "minecraft:notice",
  "title": {
    "text": "Quest 9 of 12",
    "font": "minecraft:default",
    "color": "gold",
    "bold": true
  },
  "external_title": {
    "text": "Quest 9",
    "font": "minecraft:default"
  },
  "pause": false,
  "can_close_with_escape": true,
