  "body": [
    {
      "type": "minecraft:plain_message",
      "width": 320,
      "contents": {
        "text": "",
        "font": "minecraft:default",
        "color": "white",
        "extra": [
          {
            "text": "View All Commands",
            "font": "minecraft:default",
            "color": "gold"
          },
          {
            "text": "\n\n"
          },
          {
            "text": "",
            "font": "minecraft:default",
            "color": "white",
            "bold": false
          },
          {
            "text": "Minecraft has lots of commands. You don't have to remember them - the game can show you the whole list.",
            "font": "minecraft:default",
            "bold": false,
            "color": "white"
          },
          {
            "text": "\n\n"
          },
          {
            "text": "",
            "font": "minecraft:default",
            "color": "white",
            "bold": false
          },
          {
            "text": "Type ",
            "font": "minecraft:default",
            "bold": false,
            "color": "white"
          },
          {
            "text": "/",
            "font": "minecraft:default",
            "color": "yellow",
            "bold": false
          },
          {
            "text": " then press ",
            "font": "minecraft:default",
            "bold": false,
            "color": "white"
          },
          {
            "text": "Tab",
            "font": "minecraft:default",
            "color": "yellow",
            "bold": false
          },
          {
            "text": ". A list of every command pops up.",
            "font": "minecraft:default",
            "bold": false,
            "color": "white"
          },
          {
            "text": "\n\n"
          },
          {
            "text": "",
            "font": "minecraft:default",
            "color": "white",
            "bold": false
          },
          {
            "text": "You can scroll through the list of commands with ",
            "font": "minecraft:default",
            "bold": false,
            "color": "white"
          },
          {
            "text": "Tab",
            "font": "minecraft:default",
            "color": "yellow",
            "bold": false
          },
          {
            "text": " (down), ",
            "font": "minecraft:default",
            "bold": false,
            "color": "white"
          },
          {
            "text": "Shift + Tab",
            "font": "minecraft:default",
            "color": "yellow",
            "bold": false
          },
          {
            "text": " (up), or the ",
            "font": "minecraft:default",
            "bold": false,
            "color": "white"
          },
          {
            "text": "Up / Down arrow keys",
            "font": "minecraft:default",
            "color": "yellow",
            "bold": false
          },
          {
            "text": ".",
            "font": "minecraft:default",
            "bold": false,
            "color": "white"
          },
          {
            "text": "\n\n"
          },
          {
            "text": "",
            "font": "minecraft:default",
            "color": "white",
            "bold": false
          },
          {
            "text": "Your Mission",
            "font": "minecraft:default",
            "color": "yellow",
            "bold": false
          },
          {
            "text": " - Open the list and scroll through it. Spot ",
            "font": "minecraft:default",
            "bold": false,
            "color": "white"
          },
          {
            "text": "xp",
            "font": "minecraft:default",
            "color": "yellow",
            "bold": false
          },
          {
            "text": ", ",
            "font": "minecraft:default",
            "bold": false,
            "color": "white"
          },
          {
            "text": "gamemode",
            "font": "minecraft:default",
            "color": "yellow",
            "bold": false
          },
          {
            "text": ", and ",
            "font": "minecraft:default",
            "bold": false,
            "color": "white"
          },
          {
            "text": "give",
            "font": "minecraft:default",
            "color": "yellow",
            "bold": false
          },
          {
            "text": "?",
            "font": "minecraft:default",
            "bold": false,
            "color": "white"
          },
          {
            "text": "\n\n"
          },
          {
            "text": "",
            "font": "minecraft:default",
            "color": "white",
            "bold": false
          },
          {
            "text": "Now scroll to ",
            "font": "minecraft:default",
            "bold": false,
            "color": "white"
          },
          {
            "text": "effect",
            "font": "minecraft:default",
            "color": "yellow",
            "bold": false
          },
          {
            "text": " and press ",
            "font": "minecraft:default",
            "bold": false,
            "color": "white"
          },
          {
            "text": "space",
            "font": "minecraft:default",
            "color": "yellow",
            "bold": false
          },
          {
            "text": " to type it. Finish the line so it says ",
            "font": "minecraft:default",
            "bold": false,
            "color": "white"
          },
          {
            "text": "/effect give @s invisibility",
            "font": "minecraft:default",
            "color": "yellow",
            "bold": false
          },
          {
            "text": " and press Enter.",
            "font": "minecraft:default",
            "bold": false,
            "color": "white"
          },
          {
            "text": "\n\n"
          },
          {
            "text": "",
            "font": "minecraft:default",
            "color": "white",
            "bold": false
          },
          {
            "text": "Are you invisible? Your hand should be gone. Press ",
            "font": "minecraft:default",
            "bold": false,
            "color": "white"
          },
          {
            "text": "F5",
            "font": "minecraft:default",
            "color": "yellow",
            "bold": false
          },
          {
            "text": " to look at yourself from behind - nothing there! (F5 again to go back.) If so, you've completed the quest! ",
            "font": "minecraft:default",
            "bold": false,
            "color": "white"
          },
          {
            "text": "\n\n"
          },
          {
            "text": "",
            "font": "minecraft:default",
            "color": "white",
            "bold": false
          },
          {
            "text": "The next quest starts as soon as you've done it.",
            "font": "minecraft:default",
            "color": "yellow",
            "bold": false
          },
          {
            "text": "\n\n"
          },
          {
            "text": "",
            "font": "minecraft:default",
            "color": "white",
            "bold": false
          },
          {
            "text": "Curious what a command does? /help plus its name tells you.",
            "font": "minecraft:default",
            "color": "gray",
            "bold": false
          }
        ]
      }
    }
  ],
  "action": {
    "label": {
      "text": "Continue",
      "font": "minecraft:default",
      "color": "green"
    }
  }
}
