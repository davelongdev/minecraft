{
  "type": "minecraft:multi_action",
  "title": {
    "text": "Quest 12 of 12  (part 2 of 2)",
    "font": "minecraft:default",
    "color": "gold",
    "bold": true
  },
  "external_title": {
    "text": "Quest 12",
    "font": "minecraft:default"
  },
  "pause": false,
  "can_close_with_escape": true,
  "after_action": "close",
  "body": [
    {
      "type": "minecraft:plain_message",
      "width": 320,
      "contents": {
        "text": "",
        "font": "minecraft:default",
        "color": "white",
        "extra": [
          {
            "text": "Teleport with X Y Z Coordinates",
            "font": "minecraft:default",
            "color": "gold"
          },
          {
            "text": "\n\n"
          },
          {
            "text": "",
            "font": "minecraft:default",
            "color": "white",
            "bold": false
          },
          {
            "text": "See the bridge to the new platform? Find the glass cage there, then type ",
            "font": "minecraft:default",
            "bold": false,
            "color": "white"
          },
          {
            "text": "/tp @s ",
            "font": "minecraft:default",
            "color": "yellow",
            "bold": false,
            "click_event": {
              "action": "suggest_command",
              "command": "/tp @s "
            },
            "hover_event": {
              "action": "show_text",
              "value": {
                "text": "Click to put this in your chat box",
                "font": "minecraft:uniform"
              }
            }
          },
          {
            "text": " and the 3 numbers on the sign.",
            "font": "minecraft:default",
            "bold": false,
            "color": "white"
          },
          {
            "text": "\n\n"
          },
          {
            "text": "",
            "font": "minecraft:default",
            "color": "white",
            "bold": false
          },
          {
            "text": "Tab trick",
            "font": "minecraft:default",
            "color": "yellow",
            "bold": false
          },
          {
            "text": " - look at any block, type ",
            "font": "minecraft:default",
            "bold": false,
            "color": "white"
          },
          {
            "text": "/tp @s ",
            "font": "minecraft:default",
            "color": "yellow",
            "bold": false,
            "click_event": {
              "action": "suggest_command",
              "command": "/tp @s "
            },
            "hover_event": {
              "action": "show_text",
              "value": {
                "text": "Click to put this in your chat box",
                "font": "minecraft:uniform"
              }
            }
          },
          {
            "text": " and press Tab. It types that block's numbers! (It can't see through glass, so use the sign's numbers for the cage.)",
            "font": "minecraft:default",
            "bold": false,
            "color": "white"
          },
          {
            "text": "\n\n"
          },
          {
            "text": "",
            "font": "minecraft:default",
            "color": "white",
            "bold": false
          },
          {
            "text": "Made it inside? If so, you've completed the quest! The sign in the cage shows the numbers to get back to your island. ",
            "font": "minecraft:default",
            "bold": false,
            "color": "white"
          },
          {
            "text": "\n\n"
          },
          {
            "text": "",
            "font": "minecraft:default",
            "color": "white",
            "bold": false
          },
          {
            "text": "Then go back and press the TP TO NEXT ISLAND button.",
            "font": "minecraft:default",
            "color": "yellow",
            "bold": false
          }
        ]
      }
    }
  ],
  "columns": 1,
  "actions": [
    {
      "label": {
        "text": "Put /tp @s in my chat box",
        "font": "minecraft:default"
      },
      "tooltip": {
        "text": "Types it for you. You press Enter.",
        "font": "minecraft:default"
      },
      "action": {
        "type": "minecraft:suggest_command",
        "command": "/tp @s "
      }
    }
  ],
  "exit_action": {
    "label": {
      "text": "Continue",
      "font": "minecraft:default",
