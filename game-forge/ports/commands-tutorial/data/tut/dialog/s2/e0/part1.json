            "font": "minecraft:default",
            "bold": false,
            "color": "white"
          },
          {
            "text": "\n\n"
          },
          {
            "text": "",
            "font": "minecraft:default",
            "color": "white",
            "bold": false
          },
          {
            "text": "Look in your inventory. Do you see an orange block? That's a command block! If so, you've completed the quest! ",
            "font": "minecraft:default",
            "bold": false,
            "color": "white"
          },
          {
            "text": "\n\n"
          },
          {
            "text": "",
            "font": "minecraft:default",
            "color": "white",
            "bold": false
          },
          {
            "text": "The next quest starts as soon as you've done it.",
            "font": "minecraft:default",
            "color": "yellow",
            "bold": false
          }
        ]
      }
