          },
          {
            "text": "command block",
            "font": "minecraft:default",
            "color": "yellow",
            "bold": false
          },
          {
            "text": " is a block that runs commands on its own.",
            "font": "minecraft:default",
            "bold": false,
            "color": "white"
          },
          {
            "text": "\n\n"
          },
          {
            "text": "",
            "font": "minecraft:default",
            "color": "white",
            "bold": false
          },
          {
            "text": "Command blocks only open in ",
            "font": "minecraft:default",
            "bold": false,
            "color": "white"
          },
          {
            "text": "Creative mode",
            "font": "minecraft:default",
            "color": "yellow",
            "bold": false
          },
          {
            "text": ".",
            "font": "minecraft:default",
            "bold": false,
            "color": "white"
          },
          {
            "text": "\n\n"
          },
          {
            "text": "",
            "font": "minecraft:default",
            "color": "white",
            "bold": false
          },
          {
            "text": "Your Mission",
            "font": "minecraft:default",
            "color": "yellow",
            "bold": false
          },
          {
            "text": " - Type ",
            "font": "minecraft:default",
            "bold": false,
            "color": "white"
          },
          {
            "text": "/gamemode creative",
            "font": "minecraft:default",
            "color": "yellow",
            "bold": false
          },
          {
            "text": " and press Enter. Then type ",
            "font": "minecraft:default",
            "bold": false,
            "color": "white"
          },
          {
            "text": "/give @s command_block",
            "font": "minecraft:default",
            "color": "yellow",
            "bold": false
