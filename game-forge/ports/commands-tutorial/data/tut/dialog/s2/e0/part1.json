        "extra": [
          {
            "text": "Give Yourself a Command Block",
            "font": "minecraft:default",
            "color": "gold"
          },
          {
            "text": "\n\n"
          },
          {
            "text": "",
            "font": "minecraft:default",
            "color": "white",
            "bold": false
          },
          {
            "text": "In Section 1, ",
            "font": "minecraft:default",
            "bold": false,
            "color": "white"
