# GENERATED by tools/gen_workshops.py. As a player who picked Deep Dig: the next free one of workshops 301..315.
execute unless function forge:workshop/unlocked run return fail
execute if score @s forge_wc matches 5.. run return run dialog show @s {type:"minecraft:notice",title:{text:"Personal Workshop",color:"gold",bold:true},external_title:"Personal Workshop",pause:false,body:[{type:"minecraft:plain_message",width:300,contents:"You already have 5 workshops - that's the most you can have."}],action:{label:"OK"}}
execute if score #next_deep_dig forge_ws matches 15.. run return run dialog show @s {type:"minecraft:notice",title:{text:"Personal Workshop",color:"gold",bold:true},external_title:"Personal Workshop",pause:false,body:[{type:"minecraft:plain_message",width:300,contents:"All the Deep Dig workshops are taken. Please pick another kind of land, or ask your teacher to add more."}],action:{label:"OK"}}
# a permanent player number the first time
execute unless score @s forge_id matches 1.. run scoreboard players add #next_id forge_id 1
execute unless score @s forge_id matches 1.. run scoreboard players operation @s forge_id = #next_id forge_id
scoreboard players operation #n forge_ws = #next_deep_dig forge_ws
scoreboard players add #n forge_ws 301
scoreboard players add #next_deep_dig forge_ws 1
scoreboard players add @s forge_wc 1
function forge:workshop/record {kind:"Deep Dig"}
function forge:workshop/claim_go with storage forge:main ws_new
tellraw @s ["",{text:"This is your new Personal Workshop!",color:"gold"},{text:" Build anything you like. Friends can visit, but only you can change things here. The Magic Compass takes you back to the hub.",color:"white"}]
