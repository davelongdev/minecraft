# Each game's sidebar, shown to the players on that game's team colour (Command Forge's medal teams are aqua too).
scoreboard objectives setdisplay sidebar.team.blue ob_lives
scoreboard objectives setdisplay sidebar.team.green jumps
scoreboard objectives setdisplay sidebar.team.red arena_kills
scoreboard objectives setdisplay sidebar.team.aqua tut_pts
# the hub (white) has no sidebar
scoreboard objectives setdisplay sidebar.team.white
