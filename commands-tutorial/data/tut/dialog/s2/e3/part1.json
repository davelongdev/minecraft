            "font": "minecraft:default",
            "color": "yellow",
            "bold": true
          },
          {
            "text": " - runs the command once, each time it gets a signal.",
            "font": "minecraft:default",
            "bold": true,
            "color": "white"
          },
          {
            "text": "\n\n"
          },
          {
            "text": "",
