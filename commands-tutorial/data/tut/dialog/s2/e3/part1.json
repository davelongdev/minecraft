            "color": "yellow",
            "bold": true
          },
          {
            "text": " - runs right after another command block (more on this later).",
            "font": "minecraft:default",
            "bold": true,
            "color": "white"
          },
          {
            "text": "\n\n"
          },
          {
            "text": "",
