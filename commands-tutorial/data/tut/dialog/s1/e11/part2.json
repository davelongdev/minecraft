          },
          {
            "text": "Your Mission",
            "font": "tut:clean",
            "color": "yellow",
            "bold": false
          },
          {
            "text": " - Cross the bridge to the new platform and find the glass cage. Type ",
            "font": "tut:clean",
            "bold": false,
            "color": "white"
          },
          {
            "text": "/tp @s",
            "font": "tut:clean",
            "color": "yellow",
            "bold": false
          },
          {
            "text": " and the 3 numbers on the sign next to it, then press Enter.",
            "font": "tut:clean",
            "bold": false,
            "color": "white"
          },
          {
            "text": "\n\n"
          },
          {
            "text": "",
            "font": "tut:clean",
            "color": "white",
            "bold": false
          },
          {
            "text": "Tab trick",
            "font": "tut:clean",
            "color": "yellow",
            "bold": false
          },
          {
            "text": " - look at any block, type ",
            "font": "tut:clean",
            "bold": false,
            "color": "white"
          },
          {
            "text": "/tp @s",
            "font": "tut:clean",
            "color": "yellow",
            "bold": false
          },
          {
            "text": " and press Tab. It types that block's numbers! (It can't see through glass, so use the sign's numbers for the cage.)",
            "font": "tut:clean",
            "bold": false,
            "color": "white"
          },
          {
            "text": "\n\n"
          },
          {
            "text": "",
            "font": "tut:clean",
            "color": "white",
            "bold": false
          },
          {
            "text": "Now practice getting out! Inside the cage, a sign shows your island's numbers. Type ",
            "font": "tut:clean",
            "bold": false,
            "color": "white"
          },
          {
            "text": "/tp @s",
            "font": "tut:clean",
            "color": "yellow",
            "bold": false
          },
          {
            "text": " and those 3 numbers to go back to your island.",
            "font": "tut:clean",
            "bold": false,
            "color": "white"
          },
          {
            "text": "\n\n"
          },
          {
            "text": "",
            "font": "tut:clean",
            "color": "white",
            "bold": false
          },
          {
            "text": "Back on your island? ",
            "font": "tut:clean",
            "bold": false,
            "color": "white"
          },
          {
            "text": "\n\n"
          },
          {
            "text": "",
            "font": "tut:clean",
            "color": "white",
            "bold": false
          },
          {
            "text": "Press the TP TO NEXT ISLAND button to finish the quest.",
            "font": "tut:clean",
            "color": "yellow",
            "bold": false
          }
        ]
      }
