          {
            "text": "",
            "font": "minecraft:default",
            "color": "white",
            "bold": true
          },
          {
            "text": "When the chat box is open, your mouse is free, so you can click things in chat.",
            "font": "minecraft:default",
            "bold": true,
            "color": "white"
          },
          {
            "text": "\n\n"
          },
          {
            "text": "",
            "font": "minecraft:default",
            "color": "white",
            "bold": true
          },
          {
            "text": "Try it: press ",
            "font": "minecraft:default",
            "bold": true,
            "color": "white"
