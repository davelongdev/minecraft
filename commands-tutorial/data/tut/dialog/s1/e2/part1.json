            },
            "hover_event": {
              "action": "show_text",
              "value": {
                "text": "Click to put a command in your chat box",
                "font": "minecraft:uniform"
              }
            }
          },
          {
            "text": " and watch the chat box fill in. Then press ",
            "font": "minecraft:default",
            "bold": true,
            "color": "white"
          },
          {
            "text": "Enter",
            "font": "minecraft:default",
            "color": "yellow",
            "bold": true
          },
          {
            "text": ".",
            "font": "minecraft:default",
            "bold": true,
            "color": "white"
          },
          {
            "text": "\n\n"
          },
          {
            "text": "",
            "font": "minecraft:default",
            "color": "white",
            "bold": true
          },
          {
            "text": "Got an apple? ",
            "font": "minecraft:default",
            "bold": true,
            "color": "white"
          },
          {
            "text": "Then press the NEXT QUEST button.",
            "font": "minecraft:default",
            "color": "yellow",
            "bold": true
          }
