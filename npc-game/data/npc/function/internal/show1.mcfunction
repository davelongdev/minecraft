# Macro (name, greeting, l1..l1, n1..n1): the dialog screen with 1 button(s). Inline dialog, nothing on disk.
$dialog show @s {type:"minecraft:multi_action",title:{text:"$(name)",color:"gold",bold:true},external_title:"$(name)",pause:false,can_close_with_escape:true,after_action:"close",body:[{type:"minecraft:plain_message",width:300,contents:"$(greeting)"}],columns:1,actions:[{label:{text:"$(l1)",color:"green"},action:{type:"run_command",command:"trigger npc_choice set $(n1)"}}],exit_action:{label:"Bye"}}
