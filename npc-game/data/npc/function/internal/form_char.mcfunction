# Macro (id, title, yes, name, job flags i_*, greeting, ph_*): the Name / Look / Greeting form.
# The yes button runs form_apply as the player with the typed values pasted in (ph_* = the literal $(key) placeholders).
$dialog show @s {type:"minecraft:confirmation",title:{text:"$(title)",color:"gold",bold:true},external_title:"$(title)",pause:false,body:[],inputs:[{type:"minecraft:text",key:"name",label:"Name",width:300,max_length:40,initial:"$(name)"},{type:"minecraft:single_option",key:"job",label:"Look",width:300,options:[{id:"none",display:"Plain villager",initial:$(i_none)},{id:"farmer",display:"Farmer",initial:$(i_farmer)},{id:"librarian",display:"Librarian",initial:$(i_librarian)},{id:"cleric",display:"Cleric",initial:$(i_cleric)},{id:"armorer",display:"Armorer",initial:$(i_armorer)},{id:"butcher",display:"Butcher",initial:$(i_butcher)},{id:"cartographer",display:"Cartographer",initial:$(i_cartographer)},{id:"fisherman",display:"Fisherman",initial:$(i_fisherman)},{id:"fletcher",display:"Fletcher",initial:$(i_fletcher)},{id:"leatherworker",display:"Leatherworker",initial:$(i_leatherworker)},{id:"mason",display:"Mason",initial:$(i_mason)},{id:"nitwit",display:"Nitwit",initial:$(i_nitwit)},{id:"shepherd",display:"Shepherd",initial:$(i_shepherd)},{id:"toolsmith",display:"Toolsmith",initial:$(i_toolsmith)},{id:"weaponsmith",display:"Weaponsmith",initial:$(i_weaponsmith)}]},{type:"minecraft:text",key:"greeting",label:"Greeting (what they say when clicked)",width:300,max_length:200,initial:"$(greeting)"}],yes:{label:"$(yes)",action:{type:"minecraft:dynamic/run_command",template:"function npc:internal/form_apply {id:\"$(id)\",name:\"$(ph_name)\",job:\"$(ph_job)\",greeting:\"$(ph_greeting)\"}"}},no:{label:"Cancel"}}
